# LLM provider: gemini (default) or anthropic. Without a key the app uses precomputed results.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# must be a model your key can access (gemini-2.5-* returns 404 for new keys)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_FALLBACK_MODEL=claude-haiku-5-5
# hard timeout per LLM call, seconds
LLM_TIMEOUT_S=20
# 1 = force offline/precomputed LLM results
MEZON_LLM_OFFLINE=0
DEMO_MODE=1
